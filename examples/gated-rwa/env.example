# Copy this file to `.env` and fill in. TESTNET ONLY — never put a mainnet key here.
#
# A testnet wallet private key. Fund it with testnet HSK gas from the faucet
# linked in the README before running.
PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY

# Optional: override the RPC. Defaults to the public HashKey Chain testnet RPC.
RPC_URL=https://testnet.hsk.xyz
